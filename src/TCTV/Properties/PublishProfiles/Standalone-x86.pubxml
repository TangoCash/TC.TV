<?xml version="1.0" encoding="utf-8"?>
<!--
  Einzeldatei-EXE (32 Bit), SELBSTENTHALTEN ("standalone").

  Enthält die .NET-8-Desktop-Laufzeit selbst: auf dem Zielrechner muss KEIN .NET
  installiert sein, und es gibt keinerlei zusätzliche Dateien (keine
  runtimeconfig.json, keine DLLs).

  Aufruf:  dotnet publish src/TCTV/TCTV.csproj -p:PublishProfile=Standalone-x86
  Ergebnis: dist/standalone/x86/TC.TV.exe  (eine Datei)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\standalone\x86\</PublishDir>
  </PropertyGroup>
</Project>
