<Window x:Class="TCTV.Views.EpgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TC.TV"
        Width="560"
        Height="500"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf mit Sendername -->
        <Grid Grid.Row="0" Margin="2,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.Accent}">
                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.AccentText}" />
            </Border>
            <TextBlock x:Name="HeaderText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource H1}" FontSize="15" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Liste der Sendungen -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="EventList"
                     Style="{StaticResource ModernList}"
                     ItemContainerStyle="{StaticResource ModernListItem}"
                     PreviewMouseRightButtonDown="OnEventRightClick">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="RecordMenuItem" Click="OnRecord" />
                        <MenuItem x:Name="ImdbMenuItem" Click="OnImdb" />
                        <MenuItem x:Name="TheTvdbMenuItem" Click="OnTheTvdb" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Start}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                                <TextBlock Grid.Column="1" Text="{Binding Duration}" Margin="10,0,0,0"
                                           FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                            </Grid>
                            <TextBlock Text="{Binding Title}" Margin="0,2,0,0" FontSize="12.5"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="{Binding Text}" Margin="0,1,0,0" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Width="120" Click="OnClose" />
        </WrapPanel>
    </Grid>
</Window>
