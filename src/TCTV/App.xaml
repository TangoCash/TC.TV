<Application x:Class="TCTV.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fallback-Farben. ThemeManager.Apply() ersetzt sie zur Laufzeit. -->
            <SolidColorBrush x:Key="Brush.Window" Color="#E6E6E6" />
            <SolidColorBrush x:Key="Brush.Shell" Color="#E6E6E6" />
            <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Brush.Chip" Color="#D8D8D8" />
            <SolidColorBrush x:Key="Brush.Border" Color="#C9CDD4" />
            <SolidColorBrush x:Key="Brush.Text" Color="#000000" />
            <SolidColorBrush x:Key="Brush.Muted" Color="#6B7280" />
            <SolidColorBrush x:Key="Brush.Accent" Color="#008028" />
            <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#1A9940" />
            <SolidColorBrush x:Key="Brush.AccentPressed" Color="#006922" />
            <SolidColorBrush x:Key="Brush.Selected" Color="#4CBFA8" />
            <SolidColorBrush x:Key="Brush.GhostHover" Color="#DCDCDC" />
            <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#B0B0B0" />
            <SolidColorBrush x:Key="Brush.Success" Color="#3CB102" />
            <SolidColorBrush x:Key="Brush.Danger" Color="#FF0000" />

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
