<Window x:Class="TCTV.Views.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TC.TV"
        Width="660"
        Height="540"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf mit Pfadanzeige -->
        <Grid Grid.Row="0" Margin="2,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.Accent}">
                <TextBlock Text="&#xE714;" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.AccentText}" />
            </Border>
            <Border Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Chip}" CornerRadius="8" Padding="10,5"
                    HorizontalAlignment="Left">
                <TextBlock x:Name="PathText" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.Text}" />
            </Border>
        </Grid>

        <!-- Quellen-Auswahl -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="RecordingsButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,4" Click="OnRecordings" />
            <Button x:Name="MoviesButton" Margin="0,0,6,4" Click="OnMovies" />
            <CheckBox x:Name="RecursiveBox" Margin="6,0,0,4" VerticalAlignment="Center" />
        </WrapPanel>

        <!-- Liste -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="EntryList"
                     Style="{StaticResource ModernList}"
                     ItemContainerStyle="{StaticResource ModernListItem}"
                     SelectionChanged="OnEntrySelected"
                     MouseDoubleClick="OnEntryActivated">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Icon"
                                       Grid.Column="0"
                                       Text="&#xE8B7;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="14"
                                       Margin="0,0,9,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.Text}" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding SizeText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Muted}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE768;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Beschreibung der markierten Aufnahme -->
        <Border x:Name="DetailCard" Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="DetailTitle" Style="{StaticResource H2}" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailInfo" Margin="0,4,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                <ScrollViewer Margin="0,4,0,0" MaxHeight="90" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailDescription" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="4" Margin="0,12,0,0">
            <Button x:Name="UpButton" Margin="0,0,6,0" Click="OnUp" />
            <Button x:Name="RefreshButton" Margin="0,0,6,0" Click="OnRefresh" />
            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="OnPlay" />
            <Button x:Name="CloseButton" Click="OnClose" />
        </WrapPanel>
    </Grid>
</Window>
