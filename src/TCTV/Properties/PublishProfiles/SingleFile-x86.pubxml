<?xml version="1.0" encoding="utf-8"?>
<!--
  Einzeldatei-EXE (32 Bit), framework-dependent.
  Auf dem Zielrechner wird die .NET-Desktop-Runtime (WPF) x86 benötigt – Version 8.0
  ODER neuer (siehe RollForward in TCTV.csproj).

  Aufruf:  dotnet publish src/TCTV/TCTV.csproj -p:PublishProfile=SingleFile-x86
  Ergebnis: dist/x86/TC.TV.exe  (genau eine Datei, runtimeconfig.json eingebettet)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>

    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\x86\</PublishDir>
  </PropertyGroup>
</Project>
