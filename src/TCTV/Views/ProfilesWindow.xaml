<Window x:Class="TCTV.Views.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TC.TV"
        Width="720"
        Height="580"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,14">
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.Accent}">
                <TextBlock Text="&#xE716;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.AccentText}" />
            </Border>
            <TextBlock Text="TC.TV" Style="{StaticResource H1}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profilliste -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
                <ListBox x:Name="ProfileList"
                         Style="{StaticResource ModernList}"
                         ItemContainerStyle="{StaticResource ModernListItem}"
                         SelectionChanged="OnProfileSelected" />
            </Border>

            <!-- Profildaten -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="HeaderProfile" Style="{StaticResource SectionHeader}" />
                        <Grid x:Name="FormGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- linke Spalte -->
                            <StackPanel Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="IP / DynDNS" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="HostBox" Grid.Column="0" Style="{StaticResource InputBox}" />
                                        <CheckBox x:Name="ExternalBox" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Webserver Port" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="WebPortBox" Style="{StaticResource InputBox}" />
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Streaming Port" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="StreamPortBox" Style="{StaticResource InputBox}" />
                                </StackPanel>

                                <CheckBox x:Name="WebAuthBox" Margin="0,14,0,0" />

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock x:Name="LabelWebUser" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="WebUserBox" Style="{StaticResource InputBox}" />
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock x:Name="LabelWebPassword" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="WebPasswordBox" Style="{StaticResource InputPasswordBox}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- rechte Spalte -->
                            <StackPanel Grid.Column="2">
                                <StackPanel>
                                    <TextBlock Text="ReciProxy Startverzögerung (s)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ReciProxyDelayBox" Width="90" HorizontalAlignment="Left"
                                             Style="{StaticResource InputBox}" />
                                </StackPanel>

                                <CheckBox x:Name="ReciProxyBox" Margin="0,16,0,0" />
                                <CheckBox x:Name="ForceSwitchBox" Margin="0,8,0,0" />
                                <CheckBox x:Name="FavoritesBox" Margin="0,8,0,0" />
                                <CheckBox x:Name="MultiTunerBox" Margin="0,8,0,0" />

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock x:Name="LabelApi" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ApiBox" Style="{StaticResource ModernCombo}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="NewButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="OnNew" />
            <Button x:Name="DeleteButton" Margin="0,0,6,0" Click="OnDelete" />
            <Button x:Name="ApplyButton" Margin="0,0,6,0" Click="OnApply" />
            <Button x:Name="ActivateButton" Margin="0,0,6,0" Click="OnActivate" />
            <Button x:Name="CloseButton" Click="OnClose" />
        </WrapPanel>
    </Grid>
</Window>
