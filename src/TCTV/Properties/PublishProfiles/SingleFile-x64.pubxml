<?xml version="1.0" encoding="utf-8"?>
<!--
  Einzeldatei-EXE (64 Bit), framework-dependent.
  Auf dem Zielrechner wird die .NET-Desktop-Runtime (WPF) x64 benötigt – Version 8.0
  ODER neuer (9/10/…), siehe RollForward in TCTV.csproj:
  https://dotnet.microsoft.com/download/dotnet  ("Desktop Runtime" -> Windows x64)

  Aufruf:  dotnet publish src/TCTV/TCTV.csproj -p:PublishProfile=SingleFile-x64
  Ergebnis: dist/TC.TV.exe  (genau eine Datei; die runtimeconfig.json ist mit
  eingebettet, es liegt KEINE Zusatzdatei daneben)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Keine Laufzeit einbetten: nutzt die installierte .NET-8-WPF-Runtime. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Keine PDB ablegen: das Ergebnis ist genau eine Datei. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
