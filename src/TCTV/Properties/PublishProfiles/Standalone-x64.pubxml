<?xml version="1.0" encoding="utf-8"?>
<!--
  Einzeldatei-EXE (64 Bit), SELBSTENTHALTEN ("standalone").

  Enthält die .NET-8-Desktop-Laufzeit selbst: auf dem Zielrechner muss KEIN .NET
  installiert sein, und es gibt keinerlei zusätzliche Dateien (keine
  runtimeconfig.json, keine DLLs). Läuft damit unabhängig davon, welche (oder ob
  überhaupt eine) .NET-Version vorhanden ist.

  Aufruf:  dotnet publish src/TCTV/TCTV.csproj -p:PublishProfile=Standalone-x64
  Ergebnis: dist/standalone/TC.TV.exe  (eine Datei, ca. 60-70 MB komprimiert)

  Beim ersten Start entpackt sich die EXE in %TEMP%\.net (Standardverhalten von
  Single-File-Self-Contained-Builds), der Start dauert dadurch kurz länger.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Laufzeit mit einbetten. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Keine PDB: das Ergebnis ist genau eine Datei. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\standalone\</PublishDir>
  </PropertyGroup>
</Project>
