<Window x:Class="TCTV.Views.EpgGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TC.TV"
        Width="600"
        Height="560"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Grid Grid.Row="0" Margin="2,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.Accent}">
                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.AccentText}" />
            </Border>
            <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource H1}" FontSize="15" />
        </Grid>

        <!-- Suche -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SearchLabel" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                       Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource InputBox}"
                     TextChanged="OnSearchChanged" />
        </Grid>

        <!-- Programmübersicht -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox x:Name="EventList"
                         Style="{StaticResource ModernList}"
                         ItemContainerStyle="{StaticResource ModernListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseRightButtonDown="OnEventRightClick">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RecordMenuItem" Click="OnRecord" />
                            <MenuItem x:Name="ImdbMenuItem" Click="OnImdb" />
                            <MenuItem x:Name="TheTvdbMenuItem" Click="OnTheTvdb" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                               Margin="2,10,2,2" Foreground="{DynamicResource Brush.Accent}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Start}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Margin="8,0,0,0"
                                               FontSize="11" Foreground="{DynamicResource Brush.Muted}" />
                                </Grid>
                                <TextBlock Text="{Binding Title}" Margin="0,1,0,0" FontSize="12.5"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="{Binding Text}" Margin="0,1,0,0" FontSize="11"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Font.Icons}" FontSize="26"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock x:Name="EmptyHintText" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Width="120" Click="OnClose" />
        </WrapPanel>
    </Grid>
</Window>
