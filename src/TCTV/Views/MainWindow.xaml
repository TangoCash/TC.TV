<Window x:Class="TCTV.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TC.TV"
        Width="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Border Background="{DynamicResource Brush.Shell}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1,0,1,0">
        <Grid x:Name="RootGrid" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================ Kopfzeile ============================ -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="&#xE7F4;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.AccentText}" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="TC.TV" Style="{StaticResource H1}" FontSize="16" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Muted}" />
                            <TextBlock x:Name="StatusText" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Chip}"
                        CornerRadius="8" Padding="10,5">
                    <TextBlock x:Name="TimeText" FontSize="12.5" FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource Brush.Text}" />
                </Border>
            </Grid>

            <!-- ============================= Bouquets ============================ -->
            <ComboBox x:Name="BouquetCombo"
                      Grid.Row="1"
                      Margin="0,0,0,10"
                      Style="{StaticResource ModernCombo}"
                      SelectionChanged="OnBouquetChanged" />

            <!-- ============================ Senderliste ========================== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,10">
                <Grid>
                    <ListBox x:Name="ChannelList"
                             Style="{StaticResource ModernList}"
                             ItemContainerStyle="{StaticResource ModernListItem}"
                             SelectionChanged="OnChannelChanged"
                             MouseDoubleClick="OnChannelDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        MinWidth="28" Height="28"
                                        CornerRadius="8"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.Chip}">
                                    <TextBlock Text="{Binding Number}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="6,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Muted}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding EpgStart}"
                                                   FontSize="11"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource Brush.Muted}" />
                                    </Grid>

                                    <TextBlock Text="{Binding EpgLine}"
                                               FontSize="11"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Muted}" />

                                    <ProgressBar Style="{StaticResource ThinProgress}"
                                                 Margin="0,5,0,0"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <!-- Leerzustand -->
                    <StackPanel x:Name="EmptyHint"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE7F4;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Muted}" />
                        <TextBlock x:Name="EmptyHintText"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =========================== EPG-Details =========================== -->
            <Border x:Name="DetailCard" Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource H2}" />
                    <TextBlock x:Name="DetailInfo" Margin="0,4,0,0" Style="{StaticResource Muted}" />
                    <Border x:Name="DetailSeparator" Height="1" Margin="0,8,0,6" Background="{DynamicResource Brush.Border}" />
                    <TextBlock x:Name="DetailNext" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>

            <!-- ========================== Werkzeugleiste ========================= -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0">
                    <Button x:Name="StreamButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Click="OnStream" />
                    <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Click="OnStop" />
                    <Button x:Name="VideoButton" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Click="OnVideo" />
                    <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Click="OnRefreshEpg" />
                    <Button x:Name="TimerButton" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Click="OnTimer" />
                    <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Click="OnSettings" />
                    <Button x:Name="ProfilesButton" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="OnProfiles" />
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="FullScreenButton" Style="{StaticResource IconButton}" Margin="6,0,6,6" Click="OnToggleFullScreen" />
                    <Button x:Name="ExitButton" Style="{StaticResource IconButton}" Margin="0,0,0,6" Click="OnExit" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
