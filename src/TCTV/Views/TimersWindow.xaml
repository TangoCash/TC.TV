<Window x:Class="TCTV.Views.TimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TC.TV"
        Width="560"
        Height="520"
        MinWidth="440"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Grid Grid.Row="0" Margin="2,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.Accent}">
                <TextBlock Text="&#xE823;" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.AccentText}" />
            </Border>
            <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource H1}" FontSize="15" />
        </Grid>

        <!-- Laufende Aufnahmen -->
        <StackPanel x:Name="RunningPanel" Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="RunningHeader" Style="{StaticResource SectionHeader}" />
            <TextBlock x:Name="RunningText" Margin="0,4,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Timer-Liste -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TimerHeader" Grid.Row="0" Style="{StaticResource SectionHeader}" />
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,6,0,0">
                <Grid>
                    <ListBox x:Name="TimerList"
                             Style="{StaticResource ModernList}"
                             ItemContainerStyle="{StaticResource ModernListItem}"
                             SelectionChanged="OnTimerSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                                    <TextBlock FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource Brush.Muted}">
                                        <Run Text="{Binding Channel, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Time, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource Font.Icons}" FontSize="26"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
                        <TextBlock x:Name="EmptyHintText" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Margin="0,0,6,0" Click="OnRefresh" />
            <Button x:Name="DeleteButton" Margin="0,0,6,0" Click="OnDelete" />
            <Button x:Name="CloseButton" Width="120" Click="OnClose" />
        </WrapPanel>
    </Grid>
</Window>
